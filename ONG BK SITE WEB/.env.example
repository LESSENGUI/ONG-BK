# PostgreSQL connection string. Keep this value private and server-side only.
# Default local PostgreSQL setup: keep both URLs aligned unless you intentionally use a
# separate migration connection behind a pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ongbk?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ongbk?schema=public"

# If you use Supabase/another pooler, set DATABASE_URL to the transaction pooler and
# DIRECT_URL to the session pooler for migrations, for example:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Public origin used to validate same-origin requests and build password reset links.
APP_URL="http://localhost:3000"

# Password reset email delivery (SMTP credentials are secrets).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ONG-BK <no-reply@example.org>"

# Optional operational setting. Never expose database or SMTP values with NEXT_PUBLIC_.
AUTH_SESSION_HOURS="8"

# One-time first-admin setup code. Generate a random value of at least 32 characters.
# Keep it private; the initial-admin form is disabled until this is configured.
ADMIN_SETUP_SECRET=""

# Optional private document storage outside public/. Use persistent storage in production.
PRIVATE_UPLOADS_DIR=""

# Required before accepting membership requests; set the approved retention period in days.
MEMBERSHIP_REQUEST_RETENTION_DAYS=""
