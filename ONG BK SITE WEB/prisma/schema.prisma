generator client {
  provider = "prisma-client-js"
}

model PartnerDocument {
  partnerId  String
  documentId String
  partner    Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  document   OfficialDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([partnerId, documentId])
  @@index([documentId])
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleCode {
  SYSTEM_ADMIN
  TECHNICAL_ADMIN
  BE_PRESIDENT
  BE_VICE_PRESIDENT
  SECRETARY_GENERAL
  DEPUTY_SECRETARY_GENERAL
  TREASURER_GENERAL
  DEPUTY_TREASURER_GENERAL
  ORGANISATION_COMMUNICATION_SECRETARY
  CCE_PRESIDENT
  CCE_MEMBER
  CONTENT_EDITOR
  ONG_MEMBER
}

enum PermissionCode {
  TASKS_READ
  TASKS_CREATE
  TASKS_ASSIGN
  TASKS_UPDATE
  USERS_READ
  USERS_CREATE
  USERS_UPDATE
  USERS_ARCHIVE
  USERS_EXPORT
  USERS_DELETE
  USERS_ASSIGN_ROLE
  ROLES_READ
  ROLES_UPDATE
  CONTENT_READ
  CONTENT_CREATE
  CONTENT_UPDATE
  CONTENT_APPROVE
  CONTENT_ARCHIVE
  CONTENT_EXPORT
  CONTENT_DELETE
  IDENTITY_READ
  IDENTITY_CREATE
  IDENTITY_UPDATE
  IDENTITY_APPROVE
  GOVERNANCE_READ
  GOVERNANCE_EXPORT
  BE_GOVERNANCE_CREATE
  BE_GOVERNANCE_UPDATE
  BE_GOVERNANCE_APPROVE
  BE_GOVERNANCE_ARCHIVE
  BE_GOVERNANCE_EXPORT
  CCE_GOVERNANCE_CREATE
  CCE_GOVERNANCE_UPDATE
  CCE_GOVERNANCE_APPROVE
  CCE_GOVERNANCE_ARCHIVE
  CCE_GOVERNANCE_EXPORT
  MEMBERS_READ
  MEMBERS_CREATE
  MEMBERS_UPDATE
  MEMBERS_ARCHIVE
  MEMBERS_EXPORT
  MEMBERSHIP_REQUESTS_CREATE
  MEMBERSHIP_REQUESTS_READ
  MEMBERSHIP_REQUESTS_DECIDE
  DOCUMENTS_READ
  DOCUMENTS_CREATE
  DOCUMENTS_UPDATE
  DOCUMENTS_APPROVE
  DOCUMENTS_ARCHIVE
  DOCUMENTS_EXPORT
  BE_MEETINGS_READ
  BE_MEETINGS_CREATE
  BE_MEETINGS_UPDATE
  CCE_MEETINGS_READ
  CCE_MEETINGS_CREATE
  CCE_MEETINGS_UPDATE
  RECORDS_READ
  RECORDS_CREATE
  RECORDS_UPDATE
  RECORDS_APPROVE
  RECORDS_ARCHIVE
  RECORDS_EXPORT
  RECORDS_DELETE
  FINANCE_READ
  FINANCE_CREATE
  FINANCE_UPDATE
  FINANCE_APPROVE
  FINANCE_ARCHIVE
  FINANCE_EXPORT
  FINANCE_DELETE
  CCE_FINDINGS_READ
  CCE_FINDINGS_CREATE
  CCE_FINDINGS_UPDATE
  CCE_RESPONSES_CREATE
  PROJECTS_READ
  PROJECTS_CREATE
  PROJECTS_UPDATE
  PROJECTS_APPROVE
  PROJECTS_ARCHIVE
  PROJECTS_EXPORT
  ACTIVITIES_READ
  ACTIVITIES_CREATE
  ACTIVITIES_UPDATE
  ACTIVITIES_APPROVE
  ACTIVITIES_ARCHIVE
  ACTIVITIES_EXPORT
  PARTNERS_READ
  PARTNERS_CREATE
  PARTNERS_UPDATE
  PARTNERS_APPROVE
  PARTNERS_ARCHIVE
  PARTNERS_EXPORT
  MEDIA_READ
  MEDIA_CREATE
  MEDIA_UPDATE
  MEDIA_APPROVE
  MEDIA_ARCHIVE
  MEDIA_EXPORT
  INBOX_READ
  INBOX_UPDATE
  INBOX_EXPORT
  REPORTS_READ
  REPORTS_CREATE
  REPORTS_UPDATE
  REPORTS_APPROVE
  REPORTS_ARCHIVE
  REPORTS_EXPORT
  REPORTS_DELETE
  SETTINGS_READ
  SETTINGS_UPDATE
  AUDIT_READ
  AUDIT_EXPORT
  SESSIONS_REVOKE
}

enum AuditEvent {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ACCESS_DENIED
  PERMISSION_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_ARCHIVED
  SENSITIVE_OPERATION
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum FinanceIncomeStatus {
  EXPECTED
  COMMITTED
  RECEIVED
  VERIFIED
  CANCELLED
  REVERSED
}

enum FinanceIncomeCategory {
  MEMBERSHIP_DUES
  DONATION
  GRANT
  PARTNERSHIP
  EVENT
  SPONSORSHIP
  OTHER
}

enum FinanceExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
  ARCHIVED
}

enum CceFindingStatus {
  OPEN
  IN_PROGRESS
  TREATED
  CLOSED
}

enum AdminTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum FinanceBudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum MembershipCategory {
  FOUNDING
  ACTIVE
  HONORARY
  SUPPORTER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
  REJECTED
}

enum MembershipRequestStatus {
  RECEIVED
  UNDER_REVIEW
  NEEDS_INFORMATION
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum GoverningBodyCode {
  EXECUTIVE_BOARD
  CONTROL_COMMISSION
}

enum GoverningPositionCode {
  BE_PRESIDENT
  BE_VICE_PRESIDENT
  BE_SECRETARY_GENERAL
  BE_DEPUTY_SECRETARY_GENERAL
  BE_TREASURER_GENERAL
  BE_DEPUTY_TREASURER_GENERAL
  BE_ORGANISATION_COMMUNICATION_SECRETARY
  CCE_PRESIDENT
  CCE_VICE_PRESIDENT
  CCE_RAPPORTEUR
}

enum MandateStatus {
  PLANNED
  ACTIVE
  COMPLETED
  REVOKED
}

enum DocumentCategory {
  STATUTES
  INTERNAL_REGULATION
  MINUTES
  DECISION
  APPOINTMENT
  ANNUAL_REPORT
  ACTIVITY_REPORT
  FINANCIAL_REPORT
  AGREEMENT
  OTHER
}

enum DocumentConfidentiality {
  PUBLIC
  INTERNAL
  EXECUTIVE_BOARD
  CONTROL_COMMISSION
  STRICTLY_CONFIDENTIAL
}

enum MeetingStatus {
  PLANNED
  HELD
  CANCELLED
}

enum MeetingDecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  DEFERRED
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  PLANNED
  IN_PROGRESS
  SUSPENDED
  COMPLETED
  CLOSED
  ARCHIVED
}

enum ActivityStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PartnerCategory {
  INSTITUTIONAL
  TECHNICAL
  FINANCIAL
  ASSOCIATIVE
  OTHER
}

enum PartnerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PublicationType {
  NEWS
  ANNOUNCEMENT
  PRESS_RELEASE
  ACTIVITY_REPORT
  VOLUNTEER_CALL
  PROJECT_CALL
  TRAINING_CALL
  CAMPAIGN
  PUBLICATION
  REPORT
}

enum SubmissionType {
  CONTACT
  PARTNERSHIP
  PROJECT_PROPOSAL
  VOLUNTEER
  APPLICATION
}

enum SubmissionStatus {
  RECEIVED
  IN_PROGRESS
  NEEDS_INFORMATION
  ANSWERED
  CLOSED
  ARCHIVED
}

enum MeasurementStatus {
  PLANNED
  ESTIMATED
  REALIZED
  VERIFIED
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique @db.VarChar(254)
  passwordHash         String                   @db.VarChar(100)
  roleCode             RoleCode
  isActive             Boolean                  @default(true)
  archivedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  role                 Role                     @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  profile              UserProfile?
  sessions             Session[]
  resetTokens          PasswordResetToken[]
  auditEvents          AuditLog[]               @relation("AuditActor")
  authoredPages        ContentPage[]            @relation("PageAuthor")
  reviewedPages        ContentPage[]            @relation("PageReviewer")
  membershipDecisions  MembershipRequest[]      @relation("MembershipDecisionMaker")
  membershipEvents     MembershipRequestEvent[] @relation("MembershipEventActor")
  uploadedDocuments    OfficialDocument[]       @relation("DocumentUploader")
  meetingsOrganized    Meeting[]                @relation("MeetingOrganizer")
  meetingAttendance    MeetingAttendance[]
  meetingDecisions     MeetingDecision[]        @relation("DecisionAuthor")
  projectsManaged      Project[]                @relation("ProjectManager")
  projectsAuthored     Project[]                @relation("ProjectAuthor")
  projectsReviewed     Project[]                @relation("ProjectReviewer")
  projectRevisions     ProjectRevision[]        @relation("ProjectRevisionEditor")
  activitiesManaged    Activity[]               @relation("ActivityManager")
  activityRevisions    ActivityRevision[]       @relation("ActivityRevisionEditor")
  publicationsAuthored Publication[]            @relation("PublicationAuthor")
  publicationsReviewed Publication[]            @relation("PublicationReviewer")
  submissionsAssigned  PublicSubmission[]       @relation("SubmissionAssignee")
  submissionEvents     PublicSubmissionEvent[]  @relation("SubmissionEventActor")
  uploadedMedia        MediaAsset[]             @relation("MediaUploader")
  tasksCreated         AdminTask[]              @relation("TaskCreator")
  tasksAssigned        AdminTask[]              @relation("TaskAssignee")
  periodsResponsible   FinancialPeriod[]        @relation("PeriodResponsible")
  periodsCreated       FinancialPeriod[]        @relation("PeriodCreator")
  budgetsCreated       FinanceBudget[]          @relation("BudgetCreator")
  budgetsApproved      FinanceBudget[]          @relation("BudgetApprover")
  incomesRecorded      FinanceIncome[]          @relation("IncomeRecorder")
  expensesRequested    FinanceExpense[]         @relation("ExpenseRequester")
  expensesVerified     FinanceExpense[]         @relation("ExpenseVerifier")
  expensesApproved     FinanceExpense[]         @relation("ExpenseApprover")
  expensesPaid         FinanceExpense[]         @relation("ExpensePayer")
  expenseEvents        FinanceExpenseEvent[]
  cceFindingsCreated   CceFinding[]             @relation("FindingCreator")
  cceFindingsAssigned  CceFinding[]             @relation("FindingAssignee")
  cceResponses         CceResponse[]            @relation("CceResponseAuthor")
  periodEvents         FinancialPeriodEvent[]
  budgetEvents         FinanceBudgetEvent[]
  incomeEvents         FinanceIncomeEvent[]
  cceFindingEvents     CceFindingEvent[]

  @@index([roleCode, isActive])
  @@index([archivedAt])
}

model Role {
  code        RoleCode         @id
  name        String           @db.VarChar(150)
  description String           @db.VarChar(500)
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleCode       RoleCode
  permissionCode PermissionCode
  role           Role           @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@index([permissionCode])
}

model UserProfile {
  userId    String   @id
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  phone     String?  @db.VarChar(40)
  title     String?  @db.VarChar(180)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  member    Member?
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.Char(64)
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginThrottle {
  key             String    @id @db.Char(64)
  count           Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
}

model AuditLog {
  id          String     @id @default(cuid())
  actorId     String?
  event       AuditEvent
  subjectType String?    @db.VarChar(100)
  subjectId   String?    @db.VarChar(191)
  createdAt   DateTime   @default(now())
  actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([event, createdAt])
  @@index([subjectType, subjectId])
}

model ContentPage {
  id          String            @id @default(cuid())
  key         String            @unique @db.VarChar(80)
  title       String            @db.VarChar(200)
  content     String            @default("") @db.Text
  imagePath   String?           @db.VarChar(500)
  status      ContentStatus     @default(DRAFT)
  version     Int               @default(1)
  authorId    String
  reviewerId  String?
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  author      User              @relation("PageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer    User?             @relation("PageReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  revisions   ContentRevision[]

  @@index([status, updatedAt])
}

model ContentRevision {
  id        String      @id @default(cuid())
  pageId    String
  version   Int
  title     String      @db.VarChar(200)
  content   String      @db.Text
  imagePath String?     @db.VarChar(500)
  editorId  String
  createdAt DateTime    @default(now())
  page      ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model Member {
  id          String              @id @default(cuid())
  userId      String?             @unique
  firstName   String              @db.VarChar(100)
  lastName    String              @db.VarChar(100)
  email       String?             @unique @db.VarChar(254)
  phone       String?             @db.VarChar(40)
  locality    String?             @db.VarChar(160)
  category    MembershipCategory
  status      MembershipStatus    @default(ACTIVE)
  joinedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        UserProfile?        @relation(fields: [userId], references: [userId], onDelete: SetNull)
  requests    MembershipRequest[]
  mandates    GoverningMandate[]
  attendance  MeetingAttendance[]
  projectTeam ProjectTeamMember[]

  @@index([category, status])
  @@index([lastName, firstName])
  @@index([archivedAt])
}

model MembershipRequest {
  id                String                      @id @default(cuid())
  firstName         String                      @db.VarChar(100)
  lastName          String                      @db.VarChar(100)
  email             String                      @db.VarChar(254)
  phone             String?                     @db.VarChar(40)
  locality          String?                     @db.VarChar(160)
  motivation        String                      @db.VarChar(5000)
  requestedCategory MembershipCategory?
  status            MembershipRequestStatus     @default(RECEIVED)
  internalNotes     String?                     @db.Text
  memberId          String?
  decisionAt        DateTime?
  decisionById      String?
  retentionUntil    DateTime
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  member            Member?                     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  decisionBy        User?                       @relation("MembershipDecisionMaker", fields: [decisionById], references: [id], onDelete: SetNull)
  documents         MembershipRequestDocument[]
  history           MembershipRequestEvent[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([retentionUntil])
}

model MembershipRequestDocument {
  id         String            @id @default(cuid())
  requestId  String
  documentId String            @unique
  request    MembershipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  document   OfficialDocument  @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

model MembershipRequestEvent {
  id         String                   @id @default(cuid())
  requestId  String
  actorId    String?
  fromStatus MembershipRequestStatus?
  toStatus   MembershipRequestStatus
  note       String?                  @db.VarChar(1000)
  createdAt  DateTime                 @default(now())
  request    MembershipRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User?                    @relation("MembershipEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model GoverningPosition {
  code     GoverningPositionCode @id
  bodyCode GoverningBodyCode
  title    String                @db.VarChar(220)
  ordinal  Int
  enabled  Boolean               @default(true)
  mandates GoverningMandate[]

  @@unique([bodyCode, ordinal])
  @@index([bodyCode, enabled])
}

model GoverningMandate {
  id                    String                @id @default(cuid())
  bodyCode              GoverningBodyCode
  positionCode          GoverningPositionCode
  memberId              String
  activeSlot            String?               @unique @db.VarChar(80)
  startDate             DateTime?
  endDate               DateTime?
  status                MandateStatus         @default(PLANNED)
  biography             String?               @db.VarChar(4000)
  photoPath             String?               @db.VarChar(500)
  appointmentDocumentId String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  position              GoverningPosition     @relation(fields: [positionCode], references: [code], onDelete: Restrict)
  member                Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  appointmentDocument   OfficialDocument?     @relation("MandateAppointmentDocument", fields: [appointmentDocumentId], references: [id], onDelete: SetNull)

  @@index([bodyCode, status, positionCode])
  @@index([memberId, startDate])
}

model OfficialDocument {
  id                        String                     @id @default(cuid())
  title                     String                     @db.VarChar(240)
  category                  DocumentCategory
  documentDate              DateTime?
  version                   String                     @default("1") @db.VarChar(40)
  status                    ContentStatus              @default(DRAFT)
  confidentiality           DocumentConfidentiality    @default(INTERNAL)
  storageKey                String                     @unique @db.VarChar(500)
  mediaType                 String                     @db.VarChar(100)
  fileSize                  Int
  uploadedById              String
  publishedAt               DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  uploadedBy                User                       @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  membershipRequestDocument MembershipRequestDocument?
  mandates                  GoverningMandate[]         @relation("MandateAppointmentDocument")
  minutesFor                Meeting[]                  @relation("MeetingMinutesDocument")
  projectDocuments          ProjectDocument[]
  activityDocuments         ActivityDocument[]
  partnerDocuments          PartnerDocument[]

  @@index([category, status, confidentiality])
  @@index([documentDate])
  @@index([archivedAt])
}

model Meeting {
  id                String              @id @default(cuid())
  bodyCode          GoverningBodyCode
  title             String              @db.VarChar(220)
  scheduledAt       DateTime?
  location          String?             @db.VarChar(240)
  agenda            String              @default("") @db.Text
  status            MeetingStatus       @default(PLANNED)
  organizerId       String
  minutesDocumentId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organizer         User                @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  minutesDocument   OfficialDocument?   @relation("MeetingMinutesDocument", fields: [minutesDocumentId], references: [id], onDelete: SetNull)
  participants      MeetingAttendance[]
  decisions         MeetingDecision[]

  @@index([bodyCode, scheduledAt, status])
}

model MeetingAttendance {
  id        String   @id @default(cuid())
  meetingId String
  memberId  String?
  userId    String?
  attended  Boolean?
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([meetingId, memberId])
  @@unique([meetingId, userId])
  @@index([meetingId])
}

model MeetingDecision {
  id          String                @id @default(cuid())
  meetingId   String
  title       String                @db.VarChar(220)
  description String                @db.Text
  status      MeetingDecisionStatus @default(PROPOSED)
  actionOwner String?               @db.VarChar(180)
  dueAt       DateTime?
  completedAt DateTime?
  authorId    String
  createdAt   DateTime              @default(now())
  meeting     Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author      User                  @relation("DecisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([dueAt, completedAt])
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Project {
  id                    String              @id @default(cuid())
  reference             String              @unique @db.VarChar(60)
  slug                  String              @unique @db.VarChar(180)
  title                 String              @db.VarChar(240)
  description           String              @default("") @db.Text
  justification         String              @default("") @db.Text
  problemStatement      String              @default("") @db.Text
  targetBeneficiaries   String              @default("") @db.Text
  generalObjective      String              @default("") @db.Text
  specificObjectives    String[]            @default([])
  domain                String              @db.VarChar(120)
  geographicArea        String              @default("") @db.VarChar(240)
  plannedBudget         Decimal?            @db.Decimal(18, 2)
  plannedBudgetCurrency String?             @db.Char(3)
  expectedResults       String              @default("") @db.Text
  actualResults         String              @default("") @db.Text
  difficulties          String              @default("") @db.Text
  correctiveMeasures    String              @default("") @db.Text
  status                ProjectStatus       @default(DRAFT)
  version               Int                 @default(1)
  startDate             DateTime?
  endDate               DateTime?
  managerId             String?
  authorId              String
  reviewerId            String?
  reviewedAt            DateTime?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  manager               User?               @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  author                User                @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer              User?               @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  stages                ProjectStage[]
  indicators            ProjectIndicator[]
  team                  ProjectTeamMember[]
  partners              ProjectPartner[]
  activities            Activity[]
  documents             ProjectDocument[]
  media                 MediaAsset[]
  revisions             ProjectRevision[]
  financeBudgets        FinanceBudget[]
  financeIncomes        FinanceIncome[]
  financeExpenses       FinanceExpense[]

  @@index([status, startDate, endDate])
  @@index([domain, status])
  @@index([managerId, status])
  @@index([archivedAt])
}

model ProjectRevision {
  id        String   @id @default(cuid())
  projectId String
  version   Int
  snapshot  Json
  editorId  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editor    User     @relation("ProjectRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ProjectStage {
  id          String    @id @default(cuid())
  projectId   String
  title       String    @db.VarChar(220)
  description String    @default("") @db.Text
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectIndicator {
  id           String            @id @default(cuid())
  projectId    String
  name         String            @db.VarChar(220)
  unit         String            @db.VarChar(60)
  plannedValue Decimal?          @db.Decimal(18, 4)
  actualValue  Decimal?          @db.Decimal(18, 4)
  measurement  MeasurementStatus @default(PLANNED)
  evidence     String            @default("") @db.Text
  measuredAt   DateTime?
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, measurement])
}

model ProjectTeamMember {
  id        String  @id @default(cuid())
  projectId String
  memberId  String
  role      String  @default("") @db.VarChar(180)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([projectId, memberId])
  @@index([memberId])
}

model Partner {
  id               String            @id @default(cuid())
  name             String            @unique @db.VarChar(240)
  category         PartnerCategory
  description      String            @default("") @db.Text
  logoPath         String?           @db.VarChar(500)
  publicEmail      String?           @db.VarChar(254)
  publicPhone      String?           @db.VarChar(40)
  website          String?           @db.VarChar(500)
  contactName      String?           @db.VarChar(180)
  contactEmail     String?           @db.VarChar(254)
  contactPhone     String?           @db.VarChar(40)
  collaboration    String            @default("") @db.Text
  startDate        DateTime?
  endDate          DateTime?
  status           PartnerStatus     @default(PROSPECT)
  showOnPublicSite Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projects         ProjectPartner[]
  activities       ActivityPartner[]
  documents        PartnerDocument[]

  @@index([category, status, showOnPublicSite])
}

model ProjectPartner {
  projectId String
  partnerId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([projectId, partnerId])
  @@index([partnerId])
}

model Activity {
  id                   String              @id @default(cuid())
  slug                 String              @unique @db.VarChar(180)
  title                String              @db.VarChar(240)
  description          String              @default("") @db.Text
  eventDate            DateTime?
  location             String              @default("") @db.VarChar(240)
  domain               String              @db.VarChar(120)
  projectId            String?
  managerId            String?
  objectives           String              @default("") @db.Text
  plannedParticipants  Int?
  realizedParticipants Int?
  resourcesUsed        String              @default("") @db.Text
  results              String              @default("") @db.Text
  difficulties         String              @default("") @db.Text
  correctiveMeasures   String              @default("") @db.Text
  report               String              @default("") @db.Text
  status               ActivityStatus      @default(DRAFT)
  public               Boolean             @default(false)
  version              Int                 @default(1)
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  manager              User?               @relation("ActivityManager", fields: [managerId], references: [id], onDelete: SetNull)
  partners             ActivityPartner[]
  indicators           ActivityIndicator[]
  documents            ActivityDocument[]
  media                MediaAsset[]
  revisions            ActivityRevision[]
  financeBudgets       FinanceBudget[]
  financeIncomes       FinanceIncome[]
  financeExpenses      FinanceExpense[]

  @@index([status, eventDate])
  @@index([domain, status])
  @@index([projectId, eventDate])
  @@index([managerId, status])
}

model ActivityRevision {
  id         String   @id @default(cuid())
  activityId String
  version    Int
  snapshot   Json
  editorId   String
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  editor     User     @relation("ActivityRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([activityId, version])
  @@index([activityId, createdAt])
}

model ActivityIndicator {
  id           String            @id @default(cuid())
  activityId   String
  category     String            @db.VarChar(180)
  unit         String            @default("personnes") @db.VarChar(60)
  plannedValue Decimal?          @db.Decimal(18, 4)
  actualValue  Decimal?          @db.Decimal(18, 4)
  measurement  MeasurementStatus @default(PLANNED)
  activity     Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, measurement])
}

model ActivityPartner {
  activityId String
  partnerId  String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([activityId, partnerId])
  @@index([partnerId])
}

model ProjectDocument {
  projectId  String
  documentId String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   OfficialDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([projectId, documentId])
  @@index([documentId])
}

model ActivityDocument {
  activityId String
  documentId String
  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  document   OfficialDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([activityId, documentId])
  @@index([documentId])
}

model Publication {
  id           String                @id @default(cuid())
  slug         String                @unique @db.VarChar(180)
  type         PublicationType
  title        String                @db.VarChar(240)
  summary      String                @db.VarChar(1000)
  body         String                @db.Text
  category     String                @default("") @db.VarChar(120)
  tags         String[]              @default([])
  status       ContentStatus         @default(DRAFT)
  version      Int                   @default(1)
  authorId     String
  reviewerId   String?
  coverMediaId String?               @unique
  reviewedAt   DateTime?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  author       User                  @relation("PublicationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer     User?                 @relation("PublicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  coverMedia   MediaAsset?           @relation("PublicationCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  revisions    PublicationRevision[]
  gallery      PublicationMedia[]

  @@index([status, publishedAt])
  @@index([type, status])
}

model PublicationRevision {
  id            String      @id @default(cuid())
  publicationId String
  version       Int
  title         String      @db.VarChar(240)
  summary       String      @db.VarChar(1000)
  body          String      @db.Text
  editorId      String
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, version])
  @@index([publicationId, createdAt])
}

model MediaAsset {
  id           String             @id @default(cuid())
  title        String             @db.VarChar(240)
  caption      String             @default("") @db.VarChar(1000)
  altText      String             @default("") @db.VarChar(500)
  source       String             @default("") @db.VarChar(240)
  usageRights  String             @default("") @db.VarChar(500)
  capturedAt   DateTime?
  mediaType    String             @db.VarChar(100)
  storageKey   String             @unique @db.VarChar(500)
  fileSize     Int
  status       ContentStatus      @default(DRAFT)
  uploaderId   String
  projectId    String?
  activityId   String?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  uploader     User               @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activity     Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  coverFor     Publication?       @relation("PublicationCover")
  publications PublicationMedia[]

  @@index([status, publishedAt])
  @@index([projectId, activityId])
}

model PublicationMedia {
  publicationId String
  mediaId       String
  sortOrder     Int         @default(0)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  media         MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([publicationId, mediaId])
  @@index([mediaId])
}

model PublicSubmission {
  id             String                  @id @default(cuid())
  type           SubmissionType
  status         SubmissionStatus        @default(RECEIVED)
  firstName      String                  @db.VarChar(100)
  lastName       String                  @db.VarChar(100)
  email          String                  @db.VarChar(254)
  phone          String?                 @db.VarChar(40)
  subject        String                  @db.VarChar(240)
  message        String                  @db.VarChar(10000)
  organization   String?                 @db.VarChar(240)
  internalNotes  String                  @default("") @db.Text
  reply          String                  @default("") @db.Text
  assigneeId     String?
  retentionUntil DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  assignee       User?                   @relation("SubmissionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  history        PublicSubmissionEvent[]

  @@index([type, status, createdAt])
  @@index([assigneeId, status])
  @@index([retentionUntil])
}

model PublicSubmissionEvent {
  id           String            @id @default(cuid())
  submissionId String
  actorId      String?
  fromStatus   SubmissionStatus?
  toStatus     SubmissionStatus
  note         String?           @db.VarChar(1000)
  createdAt    DateTime          @default(now())
  submission   PublicSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?             @relation("SubmissionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

model AdminTask {
  id          String          @id @default(cuid())
  title       String          @db.VarChar(200)
  description String          @default("") @db.VarChar(4000)
  status      AdminTaskStatus @default(TODO)
  dueAt       DateTime?
  createdById String
  assigneeId  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([assigneeId, status, dueAt])
  @@index([createdById, createdAt])
}

model FinancialPeriod {
  id            String                 @id @default(cuid())
  name          String                 @db.VarChar(120)
  startsAt      DateTime
  endsAt        DateTime
  status        FinancialPeriodStatus  @default(OPEN)
  responsibleId String
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  responsible   User                   @relation("PeriodResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy     User                   @relation("PeriodCreator", fields: [createdById], references: [id], onDelete: Restrict)
  budgets       FinanceBudget[]
  incomes       FinanceIncome[]
  expenses      FinanceExpense[]
  history       FinancialPeriodEvent[]

  @@index([status, startsAt, endsAt])
}

model FinanceBudget {
  id            String               @id @default(cuid())
  reference     String               @unique @db.VarChar(60)
  periodId      String
  category      String               @db.VarChar(120)
  domain        String               @db.VarChar(120)
  initialAmount Decimal              @db.Decimal(18, 2)
  revisedAmount Decimal              @db.Decimal(18, 2)
  currency      String               @db.Char(3)
  justification String               @db.VarChar(4000)
  fundingSource String?              @db.VarChar(240)
  projectId     String?
  activityId    String?
  status        FinanceBudgetStatus  @default(DRAFT)
  approvedById  String?
  approvedAt    DateTime?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  period        FinancialPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activity      Activity?            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  approvedBy    User?                @relation("BudgetApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  history       FinanceBudgetEvent[]

  @@index([periodId, category, status])
  @@index([projectId, activityId])
}

model FinanceIncome {
  id            String                @id @default(cuid())
  reference     String                @unique @db.VarChar(60)
  periodId      String
  date          DateTime
  amount        Decimal               @db.Decimal(18, 2)
  currency      String                @db.Char(3)
  category      FinanceIncomeCategory
  source        String                @db.VarChar(240)
  status        FinanceIncomeStatus   @default(EXPECTED)
  paymentMethod String?               @db.VarChar(80)
  receiptKey    String?               @db.VarChar(100)
  observations  String                @default("") @db.VarChar(2000)
  projectId     String?
  activityId    String?
  recordedById  String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  period        FinancialPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activity      Activity?             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  recordedBy    User                  @relation("IncomeRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  history       FinanceIncomeEvent[]

  @@index([periodId, status, date])
  @@index([category, source])
  @@index([projectId, activityId])
}

model FinanceExpense {
  id            String                @id @default(cuid())
  reference     String                @unique @db.VarChar(60)
  periodId      String
  requestedAt   DateTime              @default(now())
  paidAt        DateTime?
  amount        Decimal               @db.Decimal(18, 2)
  currency      String                @db.Char(3)
  category      String                @db.VarChar(120)
  purpose       String                @db.VarChar(2000)
  beneficiary   String?               @db.VarChar(240)
  paymentMethod String?               @db.VarChar(80)
  receiptKey    String?               @db.VarChar(100)
  status        FinanceExpenseStatus  @default(DRAFT)
  projectId     String?
  activityId    String?
  requesterId   String
  verifierId    String?
  approverId    String?
  payerId       String?
  observations  String                @default("") @db.VarChar(2000)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  period        FinancialPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activity      Activity?             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  requester     User                  @relation("ExpenseRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  verifier      User?                 @relation("ExpenseVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  approver      User?                 @relation("ExpenseApprover", fields: [approverId], references: [id], onDelete: Restrict)
  payer         User?                 @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  history       FinanceExpenseEvent[]

  @@index([periodId, status, requestedAt])
  @@index([projectId, activityId])
}

model FinanceExpenseEvent {
  id         String                @id @default(cuid())
  expenseId  String
  actorId    String
  fromStatus FinanceExpenseStatus?
  toStatus   FinanceExpenseStatus
  note       String?               @db.VarChar(1000)
  createdAt  DateTime              @default(now())
  expense    FinanceExpense        @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  actor      User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([expenseId, createdAt])
}

model FinancialPeriodEvent {
  id         String                 @id @default(cuid())
  periodId   String
  actorId    String
  fromStatus FinancialPeriodStatus?
  toStatus   FinancialPeriodStatus
  note       String?                @db.VarChar(1000)
  createdAt  DateTime               @default(now())
  period     FinancialPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  actor      User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([periodId, createdAt])
}

model FinanceBudgetEvent {
  id         String               @id @default(cuid())
  budgetId   String
  actorId    String
  fromStatus FinanceBudgetStatus?
  toStatus   FinanceBudgetStatus
  note       String?              @db.VarChar(1000)
  createdAt  DateTime             @default(now())
  budget     FinanceBudget        @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  actor      User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([budgetId, createdAt])
}

model FinanceIncomeEvent {
  id         String               @id @default(cuid())
  incomeId   String
  actorId    String
  fromStatus FinanceIncomeStatus?
  toStatus   FinanceIncomeStatus
  note       String?              @db.VarChar(1000)
  createdAt  DateTime             @default(now())
  income     FinanceIncome        @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  actor      User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([incomeId, createdAt])
}

model CceFinding {
  id             String            @id @default(cuid())
  reference      String            @unique @db.VarChar(60)
  title          String            @db.VarChar(240)
  observation    String            @db.VarChar(5000)
  recommendation String            @db.VarChar(5000)
  status         CceFindingStatus  @default(OPEN)
  dueAt          DateTime?
  assigneeId     String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignee       User?             @relation("FindingAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("FindingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responses      CceResponse[]
  history        CceFindingEvent[]

  @@index([status, dueAt])
  @@index([createdById, createdAt])
}

model CceResponse {
  id         String     @id @default(cuid())
  findingId  String
  authorId   String
  response   String     @db.VarChar(5000)
  corrective String     @default("") @db.VarChar(5000)
  createdAt  DateTime   @default(now())
  finding    CceFinding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  author     User       @relation("CceResponseAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([findingId, createdAt])
}

model CceFindingEvent {
  id         String            @id @default(cuid())
  findingId  String
  actorId    String
  fromStatus CceFindingStatus?
  toStatus   CceFindingStatus
  note       String?           @db.VarChar(1000)
  createdAt  DateTime          @default(now())
  finding    CceFinding        @relation(fields: [findingId], references: [id], onDelete: Restrict)
  actor      User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([findingId, createdAt])
}
